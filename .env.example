# ---------------------------------------------------------------------------
# Business Dashboard — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in what you have.
# Any connector WITHOUT its credentials simply shows realistic demo data,
# so you can wire sources up one at a time.
# ---------------------------------------------------------------------------

# Display
NEXT_PUBLIC_CURRENCY=USD

# --- Stripe (do this one first — easiest, highest value) -------------------
# Dashboard / API keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# For real-time updates, create a webhook endpoint and put its signing secret here.
STRIPE_WEBHOOK_SECRET=

# --- Meta (Instagram + Facebook share one app) ----------------------------
# Create an app at https://developers.facebook.com, link the IG Business
# account to the FB Page, generate a long-lived Page access token, and request
# the instagram_basic / instagram_manage_insights / pages_read_engagement /
# read_insights permissions (App Review).
META_ACCESS_TOKEN=
IG_BUSINESS_ID=
FB_PAGE_ID=

# --- LinkedIn (Company Page only — no personal-profile API) ----------------
# Requires an approved Marketing Developer Platform app + Page admin access.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=          # e.g. urn:li:organization:1234567
# Newsletters have no API — point this at a sheet/db if you log numbers there.
LINKEDIN_NEWSLETTER_SOURCE=

# --- Email list (pick ONE provider) ---------------------------------------
EMAIL_PROVIDER=            # mailchimp | convertkit | beehiiv
MAILCHIMP_API_KEY=
CONVERTKIT_API_KEY=
BEEHIIV_API_KEY=

# --- Cold email: Smartlead ------------------------------------------------
# API key: Smartlead → Settings → API. Docs: https://api.smartlead.ai
SMARTLEAD_API_KEY=

# --- Course sales from the website ----------------------------------------
# If checkout runs through Stripe, you may not need this — filter Stripe by
# product instead. Otherwise set the platform + its key.
COURSE_PLATFORM=           # teachable | thinkific | gumroad | kajabi | ...
COURSE_API_KEY=

# --- Amazon book sales (KDP) ----------------------------------------------
# No author sales API. Recommended: weekly upload of the KDP royalties report,
# or a tool like Bookreport. Set this once you've wired something.
AMAZON_BOOKS_SOURCE=

# --- Speaking engagements -------------------------------------------------
# No platform — manual entry. Point this at an Airtable/Notion/Google Sheet
# if you want to manage engagements there instead of in-app.
SPEAKING_SOURCE=
