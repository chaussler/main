# ---------------------------------------------------------------------------
# Podcast Reach Dashboard — environment variables
#
# Copy this file to `.env` (or `.env.local`) and fill in what you have.
# Any source WITHOUT its credentials simply shows realistic demo data,
# so you can wire sources up one at a time.
# ---------------------------------------------------------------------------

# Display
NEXT_PUBLIC_SHOW_NAME=Your Podcast

# --- Podcast host (RSS downloads — do this one first) ----------------------
# Every major host has an API for downloads-per-day + the listening-app split.
HOST_PROVIDER=             # buzzsprout | transistor | captivate | podbean | libsyn | rsscom
HOST_API_KEY=
HOST_SHOW_ID=              # podcast/show id if your host needs one

# --- OP3 prefix analytics (the open-source successor to the Podtrac prepend)
# 1. Add the prefix to your feed's enclosure URLs: https://op3.dev/e/<file-url>
#    (most hosts have a one-field "analytics prefix" setting for this)
# 2. Get a free API token at https://op3.dev/api/keys
OP3_SHOW_UUID=
OP3_TOKEN=

# --- Apple Podcasts (typically 40-60% of listening) ------------------------
# No public analytics API. Weekly CSV export from Podcasts Connect →
# Analytics, dropped into a sheet/URL the dashboard reads — or via your
# host's Apple integration if it has one.
APPLE_STATS_SOURCE=

# --- Spotify (typically 4-20% of listening) --------------------------------
# No public analytics API. Same pattern: weekly numbers from
# creators.spotify.com into a sheet/URL, or via your host's integration.
SPOTIFY_STATS_SOURCE=

# --- YouTube (best analytics API of any platform) --------------------------
# OAuth2 app on the channel's Google account; Analytics API v2.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Social clips ----------------------------------------------------------
# Wire whichever platforms you post clips to; each flips live independently.
META_ACCESS_TOKEN=         # Instagram Reels + Facebook (Graph API, App Review)
TIKTOK_ACCESS_TOKEN=       # TikTok Display API
LINKEDIN_ACCESS_TOKEN=     # Company Pages only — personal profiles have no API

# --- Email list (the audience you own — pick ONE provider) -----------------
EMAIL_PROVIDER=            # mailchimp | convertkit | beehiiv
MAILCHIMP_API_KEY=
CONVERTKIT_API_KEY=
BEEHIIV_API_KEY=

# --- CTA attribution links -------------------------------------------------
# No credentials needed — /go/{slug} works out of the box.
# Define your links in lib/links/config.ts.
